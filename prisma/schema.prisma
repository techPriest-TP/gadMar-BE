generator client {
  provider   = "prisma-client-js"
  // output     = "./generated"
  engineType = "binary"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model AuthProvider {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  provider   AuthType
  providerId String
  userId     String   @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
}

model AuthToken {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AuthTokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
  @@map("auth_tokens")
}

model User {
  id                       String                    @id @default(auto()) @map("_id") @db.ObjectId
  firstName                String
  lastName                 String
  email                    String                    @unique
  phone                    String?
  password                 String?
  refreshToken             String?
  gender                   String?
  isVerified               Boolean                   @default(false)
  role                     UserRole                  @default(USER)
  transactions             TransactionIntent[]       @relation("userTransactions")
  purchaseBatches          PurchaseBatch[]           @relation("userPurchaseBatches")
  rewards                  Reward[]                  @relation("userRewards")
  brands                   Brand[]                   @relation("brandOwner")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  authTokens               AuthToken[]
  authProviders            AuthProvider[]
  notifications            Notification[]
  notificationReadReceipts NotificationReadReceipt[]
  userDeviceTokens         UserDeviceToken[]
  // ADD THIS: Powers the "Red Box" badge on the bell icon
  notificationsLastReadAt  DateTime?

  @@map("users")
}

model Brand {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  slug                String              @unique
  logo                String?
  banner              String?
  about               String?
  phone               String
  whatsappLink        String
  email               String?
  websiteUrl          String?
  socialLinks         String[]            @default([])
  verificationStatus  BrandStatus         @default(PENDING_VERIFICATION)
  verificationNotes   String?
  warrantyPolicy      String?
  returnsPolicy       String?
  region              NigerianRegion?
  state               String?
  lga                 String?
  deliveryStates      String[]            @default([])
  pickupLocations     String[]            @default([])
  inspectionLocations String[]            @default([])
  nationwideDelivery  Boolean             @default(false)
  isFeatured          Boolean             @default(false)
  featuredUntil       DateTime?
  products            Product[]
  transactions        TransactionIntent[]
  ownerId             String?             @db.ObjectId
  owner               User?               @relation("brandOwner", fields: [ownerId], references: [id])
  commissionRate      Float               @default(5.0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([verificationStatus, isFeatured])
  @@index([region, state])
  @@map("brands")
}

model Product {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  slug                String              @unique
  description         String?
  price               Float
  oldPrice            Float?
  images              String[]            @default([])
  category            String
  condition           ProductCondition    @default(NEW)
  specifications      Json?
  stockStatus         StockStatus         @default(IN_STOCK)
  stockQuantity       Int?
  warrantyInformation String?
  returnsInformation  String?
  rewardEligible      Boolean             @default(true)
  region              NigerianRegion?
  state               String?
  lga                 String?
  deliveryStates      String[]            @default([])
  nationwideDelivery  Boolean             @default(false)
  pickupAvailable     Boolean             @default(false)
  inspectionAvailable Boolean             @default(false)
  brandId             String              @db.ObjectId
  brand               Brand               @relation(fields: [brandId], references: [id])
  transactions        TransactionIntent[]
  isFeatured          Boolean             @default(false)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([brandId, isActive])
  @@index([category, condition, stockStatus])
  @@index([region, state])
  @@map("products")
}

model TransactionIntent {
  id              String                  @id @default(auto()) @map("_id") @db.ObjectId
  batchId         String                  @db.ObjectId
  batch           PurchaseBatch           @relation(fields: [batchId], references: [id])
  userId          String?                 @db.ObjectId
  user            User?                   @relation("userTransactions", fields: [userId], references: [id])
  productId       String?                 @db.ObjectId
  product         Product?                @relation(fields: [productId], references: [id])
  brandId         String                  @db.ObjectId
  brand           Brand                   @relation(fields: [brandId], references: [id])
  status          TransactionStatus       @default(PENDING)
  refCode         String                  @unique
  amount          Float?
  finalAmount     Float?
  commission      Float?
  completedAt     DateTime?
  contactedAt     DateTime?
  expiresAt       DateTime?
  whatsappMessage String
  whatsappUrl     String
  items           TransactionIntentItem[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@map("transaction_intents")
}

model PurchaseBatch {
  id         String              @id @default(auto()) @map("_id") @db.ObjectId
  batchCode  String              @unique
  userId     String?             @db.ObjectId
  user       User?               @relation("userPurchaseBatches", fields: [userId], references: [id])
  guestName  String?
  guestPhone String?
  guestEmail String?
  intents    TransactionIntent[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@map("purchase_batches")
}

model TransactionIntentItem {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  transactionId  String            @db.ObjectId
  transaction    TransactionIntent @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId      String            @db.ObjectId
  productName    String
  productSlug    String
  productImage   String?
  unitPrice      Float
  quantity       Int
  rewardEligible Boolean
  brandId        String            @db.ObjectId
  brandName      String
  createdAt      DateTime          @default(now())

  @@index([transactionId])
  @@map("transaction_intent_items")
}

model Reward {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  userId      String       @db.ObjectId
  user        User         @relation("userRewards", fields: [userId], references: [id])
  type        RewardType   @default(PURCHASE_STREAK)
  amount      Float
  status      RewardStatus @default(PENDING)
  description String?
  claimedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("rewards")
}

model ActivityLog {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  type      ActivityType
  userId    String?      @db.ObjectId
  productId String?      @db.ObjectId
  brandId   String?      @db.ObjectId
  metadata  Json?
  message   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime     @default(now())

  @@index([type])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Commission {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  transactionId String           @unique @db.ObjectId
  brandId       String           @db.ObjectId
  amount        Float
  rate          Float
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("commissions")
}

model UserDeviceToken {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  userId     String  @db.ObjectId
  token      String  @unique //The long FCM token from the device
  deviceType String? //"Optional (e.g., 'ios', 'android', 'web')"

  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_device_tokens")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String? // Null for broadcasts
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to track who has read what
  // Relations
  user   User?                     @relation(fields: [userId], references: [id])
  readBy NotificationReadReceipt[]

  @@map("notifications")
}

model NotificationReadReceipt {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  notificationId String   @db.ObjectId
  userId         String   @db.ObjectId
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId]) // Prevents duplicate read receipts
  @@map("notification_read_receipts")
}

enum UserRole {
  USER
  BRAND_OWNER
  ADMIN
}

enum BrandStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
  NEEDS_REVIEW
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
}

enum NigerianRegion {
  NORTH_CENTRAL
  NORTH_EAST
  NORTH_WEST
  SOUTH_EAST
  SOUTH_SOUTH
  SOUTH_WEST
}

enum TransactionStatus {
  PENDING
  CONTACTED
  NEGOTIATING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum RewardType {
  PURCHASE_STREAK
  REFERRAL
  LOYALTY
  PROMOTIONAL
}

enum RewardStatus {
  PENDING
  CLAIMED
  EXPIRED
  CANCELLED
}

enum ActivityType {
  PRODUCT_VIEW
  WHATSAPP_CLICK
  BRAND_VIEW
  SEARCH
  LOGIN
  REGISTER
  TRANSACTION_INITIATED
  TRANSACTION_COMPLETED
}

enum CommissionStatus {
  PENDING
  PAID
  WAIVED
}

enum AuthType {
  GOOGLE
  EMAIL
  APPLE
  UNKNOWN
}

enum AuthTokenType {
  EMAIL_OTP
  PASSWORD_RESET
}
