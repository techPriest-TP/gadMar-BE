# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>/<database>

# Authentication
# Both secrets must be at least 32 characters.
JWT_SECRET=replace-with-a-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-another-secret-at-least-32-characters-long
JWT_EXPIRE=1h

# Email provider: postmark or resend
EMAIL_PROVIDER=postmark

# Postmark (required only when EMAIL_PROVIDER=postmark)
POSTMARK_URL=https://api.postmarkapp.com
POSTMARK_TOKEN=
POSTMARK_FROM_EMAIL=

# Resend (required only when EMAIL_PROVIDER=resend)
RESEND_API_URL=https://api.resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google OAuth — optional; all three are required to enable it
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Firebase push notifications — optional JSON on one line
FIREBASE_CONFIG=

# Cloudinary media uploads — optional until uploads are used
CLOUD_NAME=
CLOUD_KEY=
CLOUD_SECRET=

# WhatsApp
WHATSAPP_API_URL=https://wa.me

# Marketplace configuration
DEFAULT_COMMISSION_RATE=5
STREAK_THRESHOLD=3
STREAK_REWARD_AMOUNT=3000
REWARD_EXPIRY_DAYS=30
